#include <stdio.h>
#include <stdlib.h>

int subarrayBitwiseORs(int* arr, int arrSize) {
    int *result = (int *)malloc(sizeof(int) * arrSize * 32);
    int resultSize = 0;

    int *prev = (int *)malloc(sizeof(int) * 32);
    int prevSize = 0;

    for (int i = 0; i < arrSize; i++) {
        int *curr = (int *)malloc(sizeof(int) * 32);
        int currSize = 0;

        curr[currSize++] = arr[i];

        for (int j = 0; j < prevSize; j++) {
            int val = prev[j] | arr[i];

            int found = 0;
            for (int k = 0; k < currSize; k++) {
                if (curr[k] == val) {
                    found = 1;
                    break;
                }
            }

            if (!found)
                curr[currSize++] = val;
        }

        for (int j = 0; j < currSize; j++) {
            int found = 0;
            for (int k = 0; k < resultSize; k++) {
                if (result[k] == curr[j]) {
                    found = 1;
                    break;
                }
            }

            if (!found)
                result[resultSize++] = curr[j];
        }

        free(prev);
        prev = curr;
        prevSize = currSize;
    }

    free(prev);
    free(result);

    return resultSize;
}